[module]
name = "AWS Transit Hub"
url = "https://github.com/rescile/aws_transit_hub"
version = "0.0.1"
description = "The AWS Transit Hub deploys a transit network for SaaS provider in an AWS region to enable private connectivity to an onprem location. The transit network routes traffic between application VPCs and customer networks to allow operators creating a wide area cross-connect and manage security inspections and inter-service communication without the complexity of individual peering connections."
rescile_version = ">=0.1.165"

[params.location]
description = "The geographical region where solutions are deployed."
required = true
default = "Europe (Zurich)"

[params.tenant]
description = "The tenant name identifiers the organization that uses the service."
required = true
default = "kpt"

[assets."identity.csv"]
resource_type = "identity"
description = "The asset file defining virtual identities with access to AWS services."
name_template = "{% if function == 'cloud' %}{{- function  | lower -}}_{{- name  | lower -}}_{{- role | lower -}}{% else %}{{- name  | lower -}}_{{- function  | lower -}}_{{- role | lower -}}{% endif %}"
[assets."identity.csv".columns]
name = { type = "string", required = true }
function = { type = "string", required = true }
role = { type = "string", required = true }

[assets."policy.csv"]
resource_type = "policy"
description = "tbd."
name_template = "{{- name  | lower -}}_{{- function  | lower -}}_policy"
[assets."policy.csv".columns]
name = { type = "string", required = true }
function = { type = "string", required = true }

[assets."dns.csv"]
resource_type = "record"
description = "tbd."
name_template = "{{- name  | lower -}}_zone_record"
[assets."dns.csv".columns]
name = { type = "string", required = true }
function = { type = "string", required = true }
