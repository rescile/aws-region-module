#!/usr/bin/env bash

# -----------------------------------------------------------------
# 1. Capture and Validate CLI Arguments
# -----------------------------------------------------------------
ACTION="$1"

if [[ -z "$ACTION" ]]; then
    echo "❌ Error: Missing action argument." >&2
    echo "Usage: $0 {create|update_state|destroy}" >&2
    return 1 2>/dev/null || exit 1
fi

if [[ "$ACTION" != "create" && "$ACTION" != "update_state" && "$ACTION" != "destroy" ]]; then
    echo "❌ Error: Invalid action '$ACTION'." >&2
    echo "Allowed actions are: create, update_state, destroy" >&2
    return 1 2>/dev/null || exit 1
fi

# -----------------------------------------------------------------
# 2. Vault and AWS Setup
# -----------------------------------------------------------------
# Check if the local vault API is available
if curl -s -m 1 http://localhost:7600/vault/ > /dev/null; then
    echo "Fetching AWS credentials from local Vault..." >&2

    # Export them normally. direnv will detect this if sourced by direnv.
    export AWS_ACCESS_KEY_ID=$(rescile-ce vault secret get "aws" "access_key_id")
    export AWS_SECRET_ACCESS_KEY=$(rescile-ce vault secret get "aws" "secret_access_key")

    # Check AWS identity
    if command -v aws &> /dev/null; then
        AWS_ACCOUNT=$(aws sts get-caller-identity --query "Account" --output text 2>/dev/null)
        if [ -n "$AWS_ACCOUNT" ]; then
            echo -e "\033[1;32mAWS Account: $AWS_ACCOUNT\033[0m" >&2
        else
            echo "AWS credentials loaded, but authentication failed." >&2
        fi
    fi

    # -----------------------------------------------------------------
    # 3. Execution Loop (Passing the Argument)
    # -----------------------------------------------------------------
    # List of Python programs to execute
    PYTHON_SCRIPTS=(
        "transitHub.py"
    )

    echo "Starting Python automation sequence for action: $ACTION..." >&2

    for script in "${PYTHON_SCRIPTS[@]}"; do
        # Check if the file actually exists before running it
        if [ -f "$script" ]; then
            echo "Running: python3 $script $ACTION" >&2

            # Forward the validated action to the Python script
            python3 "$script" "$ACTION"

            # Check if the python script failed, and halt if it does
            if [ $? -ne 0 ]; then
                echo "❌ Error: $script failed during '$ACTION'. Halting execution." >&2
                return 1 2>/dev/null || exit 1
            fi
        else
            echo "⚠️  Warning: Script not found: $script" >&2
        fi
    done

else
    echo "⚠️  Local rescile server is not running." >&2
    echo "Run 'rescile-ce serve' to load the rescile vault." >&2
fi
