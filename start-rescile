#!/usr/bin/env bash

# Check if the local vault API is available
if curl -s -m 1 http://localhost:7600/vault/ > /dev/null; then
    echo "Fetching AWS credentials from local Vault..." >&2

    # Clean the secrets using 'tr' to remove spaces, newlines, and carriage returns
    AWS_ACCESS_KEY_ID=$(rescile-ce vault secret get "devNet" "AWS_ACCESS_KEY_ID" | tr -d '\r\n ')
    AWS_SECRET_ACCESS_KEY=$(rescile-ce vault secret get "devNet" "AWS_SECRET_ACCESS_KEY" | tr -d '\r\n ')

    # Output the exports to stdout so direnv can consume them
    echo "export AWS_ACCESS_KEY_ID=\"$AWS_ACCESS_KEY_ID\""
    echo "export AWS_SECRET_ACCESS_KEY=\"$AWS_SECRET_ACCESS_KEY\""

    # Check AWS identity
    if command -v aws &> /dev/null; then
        # We temporarily set the env vars in this subshell context just to test the connection
        export AWS_ACCESS_KEY_ID
        export AWS_SECRET_ACCESS_KEY

        AWS_ACCOUNT=$(aws sts get-caller-identity --query "Account" --output text 2>/dev/null)
        if [ -n "$AWS_ACCOUNT" ]; then
            echo -e "\033[1;32mAWS Account: $AWS_ACCOUNT\033[0m" >&2
        else
            echo "AWS credentials loaded, but authentication failed." >&2
        fi
    fi
else
    echo "⚠️  Local rescile server is not running." >&2
    echo "Run 'rescile-ce serve' to load the rescile vault." >&2
fi
