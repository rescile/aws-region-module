eval "$(./.rescile/scripts/init.sh)"
use flake

# AWS credentials
export AWS_SHARED_CREDENTIALS_FILE="$PWD/.aws/credentials"
export AWS_CONFIG_FILE="$PWD/.aws/config"

# Dynamic Salesforce token injection
echo "Fetching active Salesforce infrastructure credentials..."

export SF_INSTANCE_URL="https://orgfarm-49b58ddcb1-dev-ed.develop.my.salesforce.com"

# Isolate the token using the secure auth command safely
if command -v sf &> /dev/null; then
    export SF_ACCESS_TOKEN=$(sf org auth show-access-token --target-org rescile-dev --json 2>/dev/null | jq -r '.result.accessToken // empty')

    if [ -n "$SF_ACCESS_TOKEN" ]; then
        echo "✅ Salesforce environment tokens bound successfully."
    else
        echo "⚠️ sf CLI found, but could not retrieve access token for 'rescile-dev'."
    fi
else
    echo "⚠️ sf CLI tool not found in current PATH layer."
fi
